# Postgres (Neon). Tests do not need it.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=saakshya
# Jev (TypeSafe). JEV_API_KEY is accepted as a fallback name.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# Drafting LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# CV worker
CV_WORKER_URL=http://127.0.0.1:8001
CV_WORKER_KEY=change-me
# Canonical public origin encoded into physical QR plaques.
# Set this to the deployed HTTPS URL in Vercel Production.
APP_ORIGIN=http://localhost:3000
